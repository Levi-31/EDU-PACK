# -------------------------------------------------------------
# Playlist Scholar - Environment Configuration
# -------------------------------------------------------------

# Application & Environment
PROJECT_NAME="Playlist Scholar"
ENVIRONMENT="development"
DEBUG=true
LOG_LEVEL="INFO"
SECRET_KEY="dev-insecure-secret-key-change-in-production"

# Database (PostgreSQL for production/docker, SQLite for local standalone)
# Production: postgresql://postgres:postgres@localhost:5432/playlist_scholar
# Local/Docker default:
DATABASE_URL="sqlite:///./storage/app.db"

# Background Job Queue & Broker
# Options: "inline" (asyncio in-memory queue, zero-dependency) or "celery" (production worker)
JOB_RUNNER="inline"
REDIS_URL="redis://localhost:6379/0"
CELERY_CONCURRENCY=4

# YouTube Data API v3
# Obtain from Google Cloud Console. Leave blank when using DEMO_MODE=true
YOUTUBE_API_KEY=""

# OpenAI API Configuration
# Used for technical note generation, review agent, and optional diagrams/images
OPENAI_API_KEY=""
OPENAI_TEXT_MODEL="gpt-4o-mini"
OPENAI_REVIEW_MODEL="gpt-4o-mini"
OPENAI_IMAGE_MODEL="dall-e-3"
OPENAI_MAX_RETRIES=3
OPENAI_TIMEOUT_SECONDS=60
MAX_CONCURRENT_LLM_REQUESTS=3
ENABLE_IMAGE_GENERATION=true

# Development & Mock Mode
# When true, the application uses mock providers for YouTube, transcripts, and LLMs.
# Mock output is explicitly tagged and allows full testing without external API keys.
DEMO_MODE=true

# Storage Settings
STORAGE_BACKEND="local"
STORAGE_DIR="./storage"

# PDF Rendering Settings
# Options: "playwright" (default, high-fidelity Chromium) or "reportlab" (fallback)
PDF_RENDERER="playwright"
